{
  "name": "@kiigame/latkazombit",
  "version": "0.1.0",
  "description": "Lätkäzombit (Hockey Zombies), the reference game for KiiGame Adventure Engine",
  "type": "module",
  "dependencies": {
    "@kiigame/adventure_engine": "0.5.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@rollup/plugin-node-resolve": "16.0.3",
    "@rollup/plugin-typescript": "12.3.0",
    "@types/mocha": "^10.0.10",
    "chai": "6.2.2",
    "eslint": "10.11.0",
    "http-server": "14.1.1",
    "mocha": "12.0.2",
    "rollup": "4.60.1",
    "ts-node": "10.9.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0"
  },
  "overrides": {
    "http-server": {
      "union": {
        "qs": "6.16.0"
      }
    }
  },
  "scripts": {
    "test": "tsx ../node_modules/mocha/bin/mocha.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "copy-assets": "node scripts/copy-assets.mjs",
    "build-dev": "npm run copy-assets && ../node_modules/.bin/rollup --config --configDev",
    "start": "http-server",
    "pre-commit": "npm run typecheck && npm run lint && npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kiigame/adventure_engine.git"
  },
  "author": "Eino Keskitalo <eino.keskitalo@gmail.com>",
  "license": "BSD-3-Clause",
  "bugs": {
    "url": "https://github.com/kiigame/adventure_engine/issues"
  },
  "homepage": "https://github.com/kiigame/adventure_engine#readme"
}
