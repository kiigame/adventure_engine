{
    "extends": "../tsconfig.base.json",
    "compilerOptions": {
        "declaration": true,
        "declarationMap": true,
        "rootDir": "./src",
        "outDir": "dist",
        "allowJs": true,
        "checkJs": false,
        "declarationDir": "dist/types",
        "experimentalDecorators": true,
        "emitDecoratorMetadata": true,
        "baseUrl": "./src",
        "types": ["reflect-metadata", "mocha"],
        "lib": ["esnext", "dom"]
    },
    "include": ["src/**/*.ts"],
    "exclude": ["node_modules", "dist"]
}