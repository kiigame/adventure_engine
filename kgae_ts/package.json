{
  "name": "@kiigame/kgae_ts",
  "version": "0.1.0",
  "description": "TypeScript implementation of the core game state engine for KiiGame, a lightweight adventure game engine",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "files": ["dist"],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./inversify.config": {
      "types": "./dist/types/inversify.config.d.ts",
      "import": "./dist/inversify.config.js"
    },
    "./events/EventEmitter": {
      "types": "./dist/types/events/EventEmitter.d.ts",
      "import": "./dist/EventEmitter.js"
    }
  },
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "tsx ../node_modules/mocha/bin/mocha.js",
    "build": "../node_modules/.bin/rollup --config --configBuild",
    "pre-commit": "npm run typecheck && npm run lint && npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kiigame/adventure_engine.git"
  },
  "author": "Eino Keskitalo <eino.keskitalo@gmail.com>",
  "license": "BSD-3-Clause",
  "bugs": {
    "url": "https://github.com/kiigame/adventure_engine/issues"
  },
  "homepage": "https://github.com/kiigame/adventure_engine#readme",
  "dependencies": {
    "inversify": "8.1.0",
    "reflect-metadata": "0.2.2",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-commonjs": "29.0.3",
    "@rollup/plugin-node-resolve": "16.0.3",
    "@rollup/plugin-typescript": "12.3.0",
    "@types/mocha": "^10.0.10",
    "@types/sinon-chai": "4.0.0",
    "chai": "6.2.2",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "mocha": "12.0.0",
    "rollup": "4.60.1",
    "sinon": "22.0.0",
    "sinon-chai": "4.0.1",
    "ts-node": "10.9.2",
    "tslib": "2.8.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0"
  }
}
